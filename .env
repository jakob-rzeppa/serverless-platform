# Shared configuration for all services (local development defaults).
# Service-specific values live in <service>/.env.
# Put personal overrides / real credentials in .env.local (gitignored).

KAFKA_BROKERS=localhost:9092

# Garage (S3-compatible). Keys are generated by `garage key create`;
# set the real ones in .env.local.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key
# Optional per-bucket credentials (set both of a pair or neither); fall back
# to the shared pair above. In production give runners a read-only artifacts
# key and a write-only logs key.
# ARTIFACT_S3_ACCESS_KEY=
# ARTIFACT_S3_SECRET_KEY=
# LOG_S3_ACCESS_KEY=
# LOG_S3_SECRET_KEY=
ARTIFACT_BUCKET=apps
LOG_BUCKET=logs

RUST_LOG=info
