# runner-http specific configuration (overrides the project-root .env).
# Personal overrides go in runner-http/.env.local (gitignored).

LISTEN_ADDR=127.0.0.1:8080
# Apps are served at <subdomain>.<APPS_DOMAIN>; *.localhost resolves to 127.0.0.1.
APPS_DOMAIN=apps.localhost
CACHE_DIR=target/runner-http-cache
REQUEST_TIMEOUT_SECS=30
MEMORY_LIMIT_MB=128
LOG_REQUEST_MAX_BYTES=1048576
LOG_APP_MAX_BYTES_PER_HOUR=104857600
LOG_FLUSH_SECS=5
LOG_FLUSH_BYTES=1048576
