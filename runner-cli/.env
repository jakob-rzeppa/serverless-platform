# runner-cli specific configuration (overrides the project-root .env).
# Personal overrides go in runner-cli/.env.local (gitignored).

KAFKA_GROUP_ID=runner-cli
CACHE_DIR=target/runner-cli-cache
RUN_TIMEOUT_SECS=300
RUN_MAX_TIMEOUT_SECS=3600
MEMORY_LIMIT_MB=256
LOG_FLUSH_SECS=5
LOG_MAX_BYTES=10485760
